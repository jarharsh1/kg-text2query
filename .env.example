# Copy to .env and adjust. All values have sensible defaults.

# Ollama model server endpoint. In docker-compose this is http://ollama:11434.
# Only used to phrase results into prose — translation + execution are deterministic.
OLLAMA_HOST=http://localhost:11434

# Generation model (must be pulled in Ollama: `ollama pull llama3.2`).
KG_LLM_MODEL=llama3.2

# Set to 1 to force the deterministic offline backend (no Ollama needed).
KG_OFFLINE=0
